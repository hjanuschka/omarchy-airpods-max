From c5b9c904c0b7082e876b2377b07daef697a3d0ab Mon Sep 17 00:00:00 2001
From: Helmut Januschka <helmut@januschka.com>
Date: Fri, 23 Oct 2026 18:34:58 +0200
Subject: [PATCH 7/9] hires mic: a switch and a state line in the popup

Publishes three keys: supports_hires_mic so a daemon built without the
decoder shows no row, hires_mic_enabled for the switch, and
hires_mic_active while the stream runs. Absence reads as off, which is
what an older daemon produces.

The switch owns the source: off tears it down, so no app can pick a
microphone that is not there, and the setting persists. Arming still
follows the recorder, so the row's caption is a state line rather than
a second control: it says the microphone is in use while a call holds
it, and names the source to pick while it is idle.

Measured through the same verbs the panel sends: off removed the
source, on republished it, and the active key followed a recorder
appearing and leaving.
---
 Model.js            |  7 +++++++
 Panel.qml           | 21 ++++++++++++++++++++-
 Service.qml         | 11 +++++++++++
 daemon/main.cpp     | 32 ++++++++++++++++++++++++++++++--
 tests/model.test.js | 13 +++++++++++++
 5 files changed, 81 insertions(+), 3 deletions(-)

diff --git a/Model.js b/Model.js
index f63cde2..16aa442 100644
--- a/Model.js
+++ b/Model.js
@@ -57,6 +57,9 @@ function defaultStatus() {
     adaptiveNoiseLevel: 0,
     oneBudANC: false,
     conversationalAwareness: false,
+    supportsHiResMic: false,
+    hiResMicEnabled: false,
+    hiResMicActive: false,
     earDetectionBehavior: EAR_PAUSE_ONE_OUT,
     lidState: LID_UNKNOWN,
     left: defaultPod(),
@@ -149,6 +152,10 @@ function parseStatus(raw) {
   status.adaptiveNoiseLevel = intOr(parsed.adaptive_noise_level, 0)
   status.oneBudANC = parsed.one_bud_anc_mode === true
   status.conversationalAwareness = parsed.conversational_awareness === true
+  // A daemon built without the microphone decoder sends none of these, which reads as absent.
+  status.supportsHiResMic = parsed.supports_hires_mic === true
+  status.hiResMicEnabled = parsed.hires_mic_enabled === true
+  status.hiResMicActive = parsed.hires_mic_active === true
   status.earDetectionBehavior = intOr(parsed.ear_detection_behavior, EAR_PAUSE_ONE_OUT)
   status.lidState = intOr(parsed.lid_state, LID_UNKNOWN)
   status.left = podFrom(parsed.left)
