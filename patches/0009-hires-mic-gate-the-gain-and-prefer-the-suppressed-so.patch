From b39be935501b5b7c02e10f61efb6186a4fb4437b Mon Sep 17 00:00:00 2001
From: Helmut Januschka <helmut@januschka.com>
Date: Fri, 23 Oct 2026 18:49:47 +0200
Subject: [PATCH 10/10] hires mic: gate the gain, and prefer the suppressed
 source

The gain rode to its ceiling whenever nobody spoke, which lifted the
room with it: measured on the device, a silent passage and a spoken one
arrived at the same level. Gain is now held at unity below about
-40 dBFS, the ceiling is +12 dB rather than +18, and the gain eases
slowly enough to hold through the gaps between syllables.

tst_agc covers it: room tone at 0.004 was lifted from 92 to 742 before
this, and is left alone after.

The gate alone does not fix the uplink's own noise. Measured over
250 ms windows: a voice reached -28.7 dBFS over a -41 dBFS room, about
12 dB. RNNoise over the same uplink measured -57.5 dBFS of room against
-33.4 of voice, about 24 dB, so the call check now treats AirPodsClean
as the one to be on and offers it first.
---
 daemon/media/agc.hpp     | 15 +++++++++++----
 daemon/tests/tst_agc.cpp | 30 +++++++++++++++++++++++-------
 tools/callcheck.py       | 20 ++++++++++++++------
 3 files changed, 48 insertions(+), 17 deletions(-)

diff --git a/daemon/media/agc.hpp b/daemon/media/agc.hpp
index ad1314b..29c1452 100644
--- a/daemon/media/agc.hpp
+++ b/daemon/media/agc.hpp
@@ -20,7 +20,12 @@ namespace OpenPods::HiRes
                 // Rising level is followed quickly so a syllable is not clipped; falling level
                 // is followed slowly so a pause does not pump the gain up to the noise floor.
                 m_envelope += (level - m_envelope) * (level > m_envelope ? kAttack : kRelease);
-                const float desired = std::min(kTarget / std::max(m_envelope, 1e-4f), kMaxGain);
+                // Below the gate the frame is room tone, and lifting it is what turns a pause
+                // into audible fans. Measured on the device: the ceiling gain reached silence
+                // within milliseconds and speech and silence arrived at the same level.
+                const float desired = m_envelope < kGate
+                                          ? 1.0f
+                                          : std::min(kTarget / std::max(m_envelope, 1e-4f), kMaxGain);
                 m_gain += (desired - m_gain) * kGainEase;
                 // tanh keeps a transient inside the range instead of wrapping it.
                 samples[i] = static_cast<qint16>(std::tanh(x * m_gain) * 32767.0f);
@@ -31,10 +36,12 @@ namespace OpenPods::HiRes
 
     private:
         static constexpr float kTarget = 0.25f;   // about -12 dBFS
-        static constexpr float kMaxGain = 8.0f;   // about +18 dB
+        static constexpr float kMaxGain = 4.0f;   // about +12 dB
+        static constexpr float kGate = 0.01f;     // about -40 dBFS, under which nothing is lifted
         static constexpr float kAttack = 0.02f;
-        static constexpr float kRelease = 0.001f;
-        static constexpr float kGainEase = 0.01f;
+        // Slow enough to hold through the gaps between syllables, so a sentence keeps one gain.
+        static constexpr float kRelease = 0.0002f;
+        static constexpr float kGainEase = 0.002f;
 
         float m_envelope = 0.0f;
         float m_gain = 1.0f;
diff --git a/daemon/tests/tst_agc.cpp b/daemon/tests/tst_agc.cpp
index c0a4d3a..62ad1b5 100644
--- a/daemon/tests/tst_agc.cpp
+++ b/daemon/tests/tst_agc.cpp
@@ -30,26 +30,42 @@ class TestAgc : public QObject
     Q_OBJECT
 
 private slots:
-    void liftsAQuietFrameTowardsTheTarget();
+    void liftsSpeechTowardsTheTarget();
+    void leavesTheNoiseFloorAlone();
     void doesNotLiftAnAlreadyLoudFrame();
     void neverExceedsItsGainCeiling();
     void keepsLoudInputInRange();
 };
 
-void TestAgc::liftsAQuietFrameTowardsTheTarget()
+void TestAgc::liftsSpeechTowardsTheTarget()
 {
     // The measured uplink sits far below the target, which is the whole reason this exists.
-    QList<qint16> quiet = tone(0.01);
-    const double before = rms(quiet);
+    QList<qint16> speech = tone(0.05);
+    const double before = rms(speech);
     Agc agc;
     for (int frame = 0; frame < 40; ++frame) {
-        quiet = tone(0.01);
-        agc.process(quiet.data(), quiet.size());
+        speech = tone(0.05);
+        agc.process(speech.data(), speech.size());
     }
-    QVERIFY2(rms(quiet) > before * 2.0, "a quiet frame should end up louder");
+    QVERIFY2(rms(speech) > before * 2.0, "speech should end up louder");
     QVERIFY(agc.gain() > 1.0f);
 }
 
+void TestAgc::leavesTheNoiseFloorAlone()
+{
+    // Measured on the device: silence came back at the same level as speech, because the gain
+    // rode up to its ceiling whenever nobody was talking and lifted the fans with it.
+    QList<qint16> room = tone(0.004);
+    const double before = rms(room);
+    Agc agc;
+    for (int frame = 0; frame < 200; ++frame) {
+        room = tone(0.004);
+        agc.process(room.data(), room.size());
+    }
+    QVERIFY2(rms(room) < before * 1.5,
+             qPrintable(QStringLiteral("room tone was lifted from %1 to %2").arg(before).arg(rms(room))));
+}
+
 void TestAgc::doesNotLiftAnAlreadyLoudFrame()
 {
     Agc agc;
